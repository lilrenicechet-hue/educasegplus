    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "tela-computador.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "EDUCASEG-PLUS no computador" },
    { "src": "tela-celular.png", "sizes": "412x915", "type": "image/png", "form_factor": "narrow", "label": "EDUCASEG-PLUS no celular" }
  ],
  "shortcuts": [
