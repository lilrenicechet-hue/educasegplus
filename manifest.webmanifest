    { "name": "Problemas detectados", "short_name": "Problemas", "url": "./index.html?abrir=alertas", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Mapa de MT", "short_name": "Mapa", "url": "./index.html?abrir=mapa", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Rotas prováveis", "short_name": "Rotas", "url": "./index.html?abrir=difusao", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
